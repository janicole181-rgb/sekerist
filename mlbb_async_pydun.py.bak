def generate_random_ip():
    return f"{random.randint(1, 255)}.{random.randint(1, 255)}.{random.randint(1, 255)}.{random.randint(1, 255)}"

def generate_nonce():
    import hashlib
    raw = f"{time.time_ns()}{os.urandom(16)}"
    nonce = hashlib.md5(raw.encode()).hexdigest()
    return nonce

